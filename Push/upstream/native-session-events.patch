diff --git a/gateway/session_plugin_events.py b/gateway/session_plugin_events.py
new file mode 100644
index 0000000000..cad7fc255b
--- /dev/null
+++ b/gateway/session_plugin_events.py
@@ -0,0 +1,117 @@
+"""Supported observer facts from the canonical authority, independent of attached viewers."""
+from __future__ import annotations
+
+import hashlib
+import logging
+from pathlib import Path
+import time
+
+logger = logging.getLogger(__name__)
+NATIVE_SESSION_EVENTS_VERSION = 1
+
+
+def _bounded(value, limit):
+    from agent.redact import redact_sensitive_text
+    text = redact_sensitive_text(value, force=True, redact_url_credentials=True) if isinstance(value, str) else ""
+    return text.encode("utf-8")[:limit].decode("utf-8", errors="ignore")
+
+
+def _base(authority, session_id, generation, turn_id):
+    from gateway.session_authorities import served_profile_name
+    from gateway.session_contract import SessionRef
+    profile = served_profile_name(authority.profile_id)
+    stored = authority.physical_target(SessionRef(authority.profile_id, session_id))
+    record = authority.db.get_session(session_id) or authority.db.get_session(stored) or {}
+    return {"v": NATIVE_SESSION_EVENTS_VERSION, "profile_id": profile, "root_id": session_id,
+            "stored_id": stored, "execution_generation": generation, "turn_id": turn_id,
+            "is_subagent": record.get("source") == "subagent", "title": profile,
+            "created_at": int(time.time())}
+
+
+def _emit(authority, event):
+    from agent.plugin_stream_hooks import enqueue_plugin_stream_hook
+    from gateway.run import _profile_runtime_scope
+    identity = [event[key] for key in ("profile_id", "root_id", "execution_generation", "turn_id", "type")]
+    identity.append(event.get("request_id"))
+    import json
+    event["event_id"] = hashlib.sha256(json.dumps(identity, separators=(",", ":")).encode()).hexdigest()
+    # Settlement and prompt cleanup can run after the turn's executor scope ended.
+    # The existing bounded observer dispatcher carries this explicit owner scope
+    # into its callback thread without marking the session as viewed/delivered.
+    with _profile_runtime_scope(Path(authority.profile_id)):
+        from gateway.session_policy import policy_for_source
+        live = authority.sessions.get(event["root_id"])
+        policy = policy_for_source(authority.runner, live.source) if live is not None else None
+        if policy is not None and policy.ignore_user_config:
+            return
+        event["title"] = _bounded(event["title"], 160)
+        event["preview"] = _bounded(event["preview"], 1024)
+        enqueue_plugin_stream_hook("on_native_session_event", event=event)
+
+
+def completed(authority, ref, row, settled, response, captured):
+    """Observe a committed terminal result; failures never become completed replies."""
+    if not Path(authority.profile_id).is_absolute() or not Path(authority.profile_id).is_dir():
+        return  # only a live, resolved profile may enter a plugin's scope
+    try:
+        outcome = settled["outcome"]
+        event_type = {"completed": "turn.completed", "failed": "turn.failed",
+                      "unknown": "turn.unknown", "interrupted": "turn.interrupted",
+                      "cancelled": "turn.interrupted"}.get(outcome)
+        if event_type is None:
+            return
+        if type(row.get("generation")) is not int or row["generation"] < 1:
+            return  # an unstarted cancellation is not a completed execution
+        result = (captured or {}).get("result") or {}
+        text = response or result.get("final_response") or ""
+        from gateway.response_filters import is_intentional_silence_agent_result, silence_allowed
+        # This flag is owned by the turn's presentation policy, never inferred by
+        # an external plugin from transcript text or private agent attributes.
+        muted = result.get("_notification_reply_muted") is True
+        payload = row.get("payload") or {}
+        automation = payload.get("local_automation_v1") or (payload.get("native_text_v1") or {}).get("automation") or {}
+        quiet_marker = (silence_allowed(automation.get("display_kind") or ("internal_notification" if automation else None))
+                        and is_intentional_silence_agent_result(result, text))
+        meaningful = (outcome in {"failed", "unknown"} or outcome == "completed" and bool(text.strip())
+                      and not muted and not quiet_marker)
+        preview = {"failed": "The turn failed.", "unknown": "The turn's outcome is unknown."}.get(
+            outcome, text if meaningful else "")
+        event = _base(authority, ref.session_id, row["generation"], row["admission_id"])
+        event.update(type=event_type, kind="failure" if outcome in {"failed", "unknown"} else "reply",
+                     request_id=None, meaningful=meaningful,
+                     preview=preview)
+        _emit(authority, event)
+    except Exception:
+        # Observers cannot change an already committed execution or withhold its frame.
+        logger.exception("Native session terminal observer failed")
+
+
+def control_observer(authority, session_id, generation):
+    """Capture canonical coordinates once, before the prompt can resolve or compress."""
+    if not Path(authority.profile_id).is_absolute() or not Path(authority.profile_id).is_dir():
+        return None
+    try:
+        live = authority.sessions[session_id]
+        stamp = live.event_stream.execution
+        turn_id = stamp.get("admission_id")
+        if not turn_id or stamp.get("execution_generation") != generation:
+            return None
+        base = _base(authority, session_id, generation, turn_id)
+    except Exception:
+        logger.exception("Native session prompt observer capture failed")
+        return None
+
+    def observe(event_type, prompt):
+        try:
+            kind = "question" if prompt["kind"] == "clarify" else "approval"
+            # Commands and answers are deliberately excluded from the preview contract.
+            preview = prompt.get("question", "") if kind == "question" else "Approval needed"
+            timeout = prompt.get("timeout_s")
+            lifetime = min(300, max(1, int(timeout))) if isinstance(timeout, (int, float)) else 300
+            event = {**base, "type": event_type, "request_id": prompt["prompt_id"], "kind": kind,
+                     "meaningful": event_type == "request.waiting", "preview": preview,
+                     "expires_at": base["created_at"] + lifetime}
+            _emit(authority, event)
+        except Exception:
+            logger.exception("Native session prompt observer failed")
+    return observe
