+"""Native notification observers consume committed authority facts, not agent guesses."""
+import asyncio
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_authority import LiveSession, SessionAuthority
+from gateway.session_contract import Principal, SessionRef, Submission
+from hermes_state import SessionDB
+from hermes_state_runtime import begin_runtime_epoch
+
+
+def _owner(tmp_path, monkeypatch, *, profile="default", capture=True):
+    home = tmp_path if profile == "default" else tmp_path / "profiles" / profile
+    home.mkdir(parents=True, exist_ok=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    db = SessionDB(db_path=home / "state.db")
+    db.create_session("root", source="cli")
+    runner = SimpleNamespace(_draining=False, config=SimpleNamespace(multiplex_profiles=False),
+                             _adapter_for_source=lambda source: None)
+    authority = SessionAuthority(runner, profile_id=str(home), instance_id="test", db=db,
+                                 epoch=begin_runtime_epoch(db, instance_id="test"))
+    authority.sessions["root"] = LiveSession(SimpleNamespace(platform=None, user_id="owner"), "route")
+    monkeypatch.setattr(authority, "_schedule", lambda ref: None)
+    ref = SessionRef(str(home), "root")
+    actor = Principal("owner", str(home), frozenset({"session:submit", "session:control"}), "test")
+    events = []
+
+    def observe(hook, **payload):
+        from hermes_constants import get_hermes_home
+        events.append((hook, payload["event"], str(get_hermes_home())))
+        return True
+    if capture:
+        monkeypatch.setattr("agent.plugin_stream_hooks.enqueue_plugin_stream_hook", observe)
+    return db, authority, ref, actor, events
+
+
+@pytest.mark.asyncio
+async def test_native_completion_names_canonical_root_and_physical_tip_without_a_viewer(tmp_path, monkeypatch):
+    db, authority, ref, actor, events = _owner(tmp_path, monkeypatch, profile="research")
+
+    async def execute(owner, ref, row):
+        db.publish_compression_child(parent_session_id="root", child_session_id="tip", source="cli",
+            messages=[{"role": "assistant", "content": "summary"}], require_compression_lease=False)
+        owner.pending_results[row["admission_id"]] = {
+            "result": {"final_response": "The answer is ready.", "session_id": "tip"}, "usage": {}}
+        return "The answer is ready."
+    monkeypatch.setattr("gateway.session_finite.execute_finite_admission", execute)
+    with db:
+        receipt = await authority.submit(actor, Submission("one", ref, {"text": "work"}, "queue"))
+        await asyncio.wait_for(authority._drain(ref), 5)
+    assert len(events) == 1
+    hook, event, scope = events[0]
+    assert hook == "on_native_session_event"
+    assert event["type"] == "turn.completed"
+    assert (event["profile_id"], event["root_id"], event["stored_id"]) == ("research", "root", "tip")
+    assert event["turn_id"] == receipt.admission_id and event["execution_generation"] == 1
+    assert event["meaningful"] is True and event["preview"] == "The answer is ready."
+    assert scope == str(tmp_path / "profiles" / "research")
+    assert event["v"] == 1 and event["request_id"] is None
