+"""Explicit-profile installation uses normal dashboard auth and real isolated plugin I/O."""
+
+from pathlib import Path
+import subprocess
+
+import pytest
+
+
+@pytest.fixture
+def installation(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / ".hermes"
+    home.mkdir(exist_ok=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    from hermes_cli import profiles
+    from hermes_cli.config import atomic_config_write
+    from hermes_cli.web_server import app, _SESSION_HEADER_NAME, _SESSION_TOKEN
+    from starlette.testclient import TestClient
+
+    target = profiles.create_profile("push-target", no_alias=True, no_skills=True)
+    atomic_config_write(home / "config.yaml", {"plugins": {"enabled": []}})
+    source = tmp_path / "plugin-source"
+    source.mkdir()
+    (source / "plugin.yaml").write_text("name: scope-probe\nversion: 1.0.0\n")
+    (source / "__init__.py").write_text("def register(ctx):\n    pass\n")
+    subprocess.run(["git", "init", "-q", str(source)], check=True)
+    subprocess.run(["git", "-C", str(source), "add", "."], check=True)
+    subprocess.run(["git", "-C", str(source), "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid",
+                    "-c", "commit.gpgsign=false", "commit", "-qm", "fixture"], check=True)
+    ref = subprocess.check_output(["git", "-C", str(source), "rev-parse", "HEAD"], text=True).strip()
+    client = TestClient(app, raise_server_exceptions=False, headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+    return client, home, target, {"identifier": source.as_uri(), "ref": ref, "enable": True, "force": False}
+
+
+@pytest.mark.parametrize("profile", ["default", "push-target"])
+def test_scoped_install_changes_only_the_confirmed_profile(installation, profile):
+    client, home, target, body = installation
+    launch_before = (home / "config.yaml").read_bytes()
+    from hermes_cli.config import load_config
+    from hermes_cli.web_server_profiles import _config_profile_scope
+
+    response = client.post("/api/dashboard/agent-plugins/install-profile", json={**body, "profile": profile})
+
+    assert response.status_code == 200, response.text
+    assert response.json()["ok"] is True and response.json()["profile"] == profile
+    selected = target if profile == "push-target" else home
+    untouched = home if profile == "push-target" else target
+    assert (selected / "plugins" / "scope-probe" / "plugin.yaml").is_file()
+    assert not (untouched / "plugins" / "scope-probe").exists()
+    with _config_profile_scope(profile):
+        assert "scope-probe" in load_config()["plugins"]["enabled"]
+    if profile == "push-target":
+        assert (home / "config.yaml").read_bytes() == launch_before
+
+
+@pytest.mark.parametrize("profile", ["", "current", "missing-profile", "../escape"])
+def test_scoped_install_refuses_ambiguous_or_missing_profiles(installation, profile):
+    client, home, target, body = installation
+    response = client.post("/api/dashboard/agent-plugins/install-profile", json={**body, "profile": profile})
+    assert response.status_code in {400, 404, 422}
+    assert not (home / "plugins" / "scope-probe").exists()
+    assert not (target / "plugins" / "scope-probe").exists()
+
+
+def test_scoped_install_requires_existing_dashboard_authentication(installation):
+    client, home, target, body = installation
+    client.headers.clear()
+    response = client.post("/api/dashboard/agent-plugins/install-profile", json={**body, "profile": "push-target"})
+    assert response.status_code in {401, 403}
