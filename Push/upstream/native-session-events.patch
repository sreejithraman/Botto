+"""An isolated notification consumer can detect and consume the native event contract."""
+import pytest
+
+from hermes_cli.plugins import PluginManager
+from tests.hermes_cli.test_plugin_host import _home_with_plugins
+
+
+@pytest.mark.platforms("any")
+def test_isolated_consumer_sees_native_event_capability_and_payload(tmp_path, monkeypatch):
+    _home_with_plugins(tmp_path, monkeypatch, {"native-contract": '''
+def register(ctx):
+    version = getattr(ctx, "native_session_events_version", 0)
+    if version != 1:
+        raise RuntimeError("Native session events are unavailable")
+    def observe(event, **kwargs):
+        return {"version": version, "root_id": event["root_id"], "profile_id": ctx.profile_name}
+    ctx.register_hook("on_native_session_event", observe)
+'''})
+    manager = PluginManager()
+    try:
+        manager.discover_and_load()
+        assert manager._plugins["native-contract"].error is None
+        result = manager.invoke_hook("on_native_session_event", event={"v": 1, "root_id": "canonical-chat"})
+        assert result == [{"version": 1, "root_id": "canonical-chat", "profile_id": "default"}]
+    finally:
+        manager.unload()
+        manager._plugin_host().shutdown()
